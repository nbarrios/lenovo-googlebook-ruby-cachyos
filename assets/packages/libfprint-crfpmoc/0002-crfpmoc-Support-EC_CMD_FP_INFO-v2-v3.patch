diff --git a/tests/test-crfpmoc-fp-info.c b/tests/test-crfpmoc-fp-info.c
new file mode 100644
index 00000000..fd2176aa
--- /dev/null
+++ b/tests/test-crfpmoc-fp-info.c
@@ -0,0 +1,268 @@
+/*
+ * Unit tests for the crfpmoc EC_CMD_FP_INFO parser
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <string.h>
+#include <gio/gio.h>
+
+#include "crfpmoc-fp-info.h"
+
+static void
+put16 (guint8 *p, guint16 v)
+{
+  p[0] = v & 0xff;
+  p[1] = v >> 8;
+}
+
+static void
+put32 (guint8 *p, guint32 v)
+{
+  for (int i = 0; i < 4; i++)
+    p[i] = (v >> (8 * i)) & 0xff;
+}
+
+/* Header shared by v2 and v3 */
+static void
+fill_header (guint8 *b, guint16 num_capture_types)
+{
+  put32 (b + 0, 0x20534745);  /* vendor "EGS " */
+  put32 (b + 4, 0x00000171);  /* product */
+  put32 (b + 8, 0x00000660);  /* model */
+  put32 (b + 12, 0x00000001); /* version */
+  put16 (b + 16, num_capture_types);
+  put16 (b + 18, 0x0003);     /* errors */
+  put32 (b + 20, 5156);       /* template_size */
+  put16 (b + 24, 5);          /* template_max */
+  put16 (b + 26, 2);          /* template_valid */
+  put32 (b + 28, 0x2);        /* template_dirty */
+  put32 (b + 32, 4);          /* template_version */
+}
+
+static void
+fill_v3_frame (guint8 *f, guint32 frame_size, guint16 w, guint16 h, guint8 type)
+{
+  put32 (f + 0, frame_size);
+  put32 (f + 4, 0x40);        /* image_data_offset_bytes */
+  put32 (f + 8, 0x59455247);  /* V4L2 GREY */
+  put16 (f + 12, w);
+  put16 (f + 14, h);
+  put16 (f + 16, 8);
+  f[18] = type;
+  f[19] = 0;
+}
+
+static void
+check_header (const CrfpMocFpInfo *info)
+{
+  g_assert_cmphex (info->vendor_id, ==, 0x20534745);
+  g_assert_cmphex (info->product_id, ==, 0x171);
+  g_assert_cmphex (info->model_id, ==, 0x660);
+  g_assert_cmpuint (info->version, ==, 1);
+  g_assert_cmphex (info->errors, ==, 3);
+  g_assert_cmpuint (info->template_size, ==, 5156);
+  g_assert_cmpuint (info->template_max, ==, 5);
+  g_assert_cmpuint (info->template_valid, ==, 2);
+  g_assert_cmphex (info->template_dirty, ==, 2);
+  g_assert_cmpuint (info->template_version, ==, 4);
+}
+
+static void
+test_pick_version (void)
+{
+  g_assert_cmpint (crfpmoc_fp_info_pick_version (0x8), ==, 3); /* srebrna */
+  g_assert_cmpint (crfpmoc_fp_info_pick_version (0x3), ==, 1); /* bloonchipper */
+  g_assert_cmpint (crfpmoc_fp_info_pick_version (0x2), ==, 1);
+  g_assert_cmpint (crfpmoc_fp_info_pick_version (0x6), ==, 2);
+  g_assert_cmpint (crfpmoc_fp_info_pick_version (0xe), ==, 3);
+  g_assert_cmpint (crfpmoc_fp_info_pick_version (0x1), ==, -1); /* v0 only */
+  g_assert_cmpint (crfpmoc_fp_info_pick_version (0x0), ==, -1);
+  g_assert_cmpint (crfpmoc_fp_info_pick_version (0x10), ==, -1);
+}
+
+static void
+test_response_size (void)
+{
+  g_assert_cmpuint (crfpmoc_fp_info_response_size (1), ==, 48);
+  g_assert_cmpuint (crfpmoc_fp_info_response_size (2), ==, 36 + 10 * 16);
+  g_assert_cmpuint (crfpmoc_fp_info_response_size (3), ==, 36 + 10 * 20);
+  g_assert_cmpuint (crfpmoc_fp_info_response_size (0), ==, 0);
+  g_assert_cmpuint (crfpmoc_fp_info_response_size (4), ==, 0);
+  /* Must fit the driver's CRFPMOC_EC_PROTO2_MAX_PARAM_SIZE (0xfc) clamp */
+  g_assert_cmpuint (crfpmoc_fp_info_response_size (3), <=, 0xfc);
+}
+
+static void
+test_v1 (void)
+{
+  g_autoptr(GError) error = NULL;
+  /* FP_INFO v1 response from the recorded FPC sensor in tests/crfpmoc */
+  static const guint8 v1[48] = {
+    0x46, 0x50, 0x43, 0x20, 0x09, 0x00, 0x00, 0x00, 0x1F, 0x02, 0x00, 0x00,
+    0x01, 0x00, 0x00, 0x00, 0x94, 0x66, 0x00, 0x00, 0x47, 0x52, 0x45, 0x59,
+    0xA0, 0x00, 0xA0, 0x00, 0x08, 0x00, 0xFF, 0x03, 0x24, 0x14, 0x00, 0x00,
+    0x05, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00,
+  };
+  CrfpMocFpInfo info;
+
+  g_assert_true (crfpmoc_fp_info_parse (1, v1, sizeof (v1), &info, &error));
+  g_assert_no_error (error);
+  g_assert_cmphex (info.vendor_id, ==, 0x20435046); /* "FPC " */
+  g_assert_cmphex (info.model_id, ==, 0x21f);
+  g_assert_true (info.has_frame);
+  g_assert_cmpuint (info.frame_size, ==, 0x6694);
+  g_assert_cmpuint (info.width, ==, 160);
+  g_assert_cmpuint (info.height, ==, 160);
+  g_assert_cmpuint (info.bpp, ==, 8);
+  g_assert_cmphex (info.errors, ==, 0x3ff);
+  g_assert_cmpuint (info.template_size, ==, 5156);
+  g_assert_cmpuint (info.template_max, ==, 5);
+  g_assert_cmpuint (info.template_valid, ==, 1);
+  g_assert_cmpuint (info.template_version, ==, 4);
+  g_assert_cmpuint (info.num_capture_types, ==, 1);
+
+  g_assert_false (crfpmoc_fp_info_parse (1, v1, sizeof (v1) - 1, &info, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+}
+
+static void
+test_v3 (void)
+{
+  g_autoptr(GError) error = NULL;
+  guint8 b[36 + 10 * 20] = { 0 };
+  CrfpMocFpInfo info;
+
+  fill_header (b, 2);
+  /* First entry is a test pattern, second the vendor format: prefer it */
+  fill_v3_frame (b + 36, 1000, 64, 80, 4);
+  fill_v3_frame (b + 56, 27000, 180, 150, CRFPMOC_FP_CAPTURE_VENDOR_FORMAT);
+
+  g_assert_true (crfpmoc_fp_info_parse (3, b, sizeof (b), &info, &error));
+  g_assert_no_error (error);
+  check_header (&info);
+  g_assert_cmpuint (info.num_capture_types, ==, 2);
+  g_assert_true (info.has_frame);
+  g_assert_cmpuint (info.capture_type, ==, CRFPMOC_FP_CAPTURE_VENDOR_FORMAT);
+  g_assert_cmpuint (info.frame_size, ==, 27000);
+  g_assert_cmphex (info.pixel_format, ==, 0x59455247);
+  g_assert_cmpuint (info.width, ==, 180);
+  g_assert_cmpuint (info.height, ==, 150);
+  g_assert_cmpuint (info.bpp, ==, 8);
+}
+
+static void
+test_v3_no_vendor_format (void)
+{
+  g_autoptr(GError) error = NULL;
+  guint8 b[36 + 10 * 20] = { 0 };
+  CrfpMocFpInfo info;
+
+  fill_header (b, 2);
+  fill_v3_frame (b + 36, 1000, 64, 80, 4);
+  fill_v3_frame (b + 56, 2000, 32, 32, 8);
+
+  g_assert_true (crfpmoc_fp_info_parse (3, b, sizeof (b), &info, &error));
+  g_assert_true (info.has_frame);
+  g_assert_cmpuint (info.capture_type, ==, 4);
+  g_assert_cmpuint (info.frame_size, ==, 1000);
+}
+
+static void
+test_v3_header_only (void)
+{
+  g_autoptr(GError) error = NULL;
+  guint8 b[36 + 10 * 20] = { 0 };
+  CrfpMocFpInfo info;
+
+  /* num_capture_types claims more entries than were received */
+  fill_header (b, 10);
+  fill_v3_frame (b + 36, 27000, 180, 150, CRFPMOC_FP_CAPTURE_VENDOR_FORMAT);
+
+  g_assert_true (crfpmoc_fp_info_parse (3, b, 36, &info, &error));
+  g_assert_no_error (error);
+  check_header (&info);
+  g_assert_false (info.has_frame);
+
+  /* One full entry plus a partial one */
+  g_assert_true (crfpmoc_fp_info_parse (3, b, 36 + 20 + 7, &info, &error));
+  g_assert_true (info.has_frame);
+  g_assert_cmpuint (info.width, ==, 180);
+
+  /* Absurd count is clamped to FP_MAX_CAPTURE_TYPES and the buffer */
+  fill_header (b, 0xffff);
+  g_assert_true (crfpmoc_fp_info_parse (3, b, sizeof (b), &info, &error));
+  g_assert_cmpuint (info.num_capture_types, ==, 0xffff);
+
+  g_assert_false (crfpmoc_fp_info_parse (3, b, 35, &info, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+}
+
+static void
+test_v2 (void)
+{
+  g_autoptr(GError) error = NULL;
+  guint8 b[36 + 10 * 16] = { 0 };
+  guint8 *f = b + 36;
+  CrfpMocFpInfo info;
+
+  fill_header (b, 1);
+  put32 (f + 0, 25600);
+  put32 (f + 4, 0x59455247);
+  put16 (f + 8, 160);
+  put16 (f + 10, 160);
+  put16 (f + 12, 8);
+  f[14] = CRFPMOC_FP_CAPTURE_VENDOR_FORMAT;
+
+  g_assert_true (crfpmoc_fp_info_parse (2, b, sizeof (b), &info, &error));
+  g_assert_no_error (error);
+  check_header (&info);
+  g_assert_true (info.has_frame);
+  g_assert_cmpuint (info.frame_size, ==, 25600);
+  g_assert_cmpuint (info.width, ==, 160);
+  g_assert_cmpuint (info.height, ==, 160);
+  g_assert_cmpuint (info.bpp, ==, 8);
+}
+
+static void
+test_bad_version (void)
+{
+  g_autoptr(GError) error = NULL;
+  guint8 b[64] = { 0 };
+  CrfpMocFpInfo info;
+
+  g_assert_false (crfpmoc_fp_info_parse (0, b, sizeof (b), &info, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED);
+  g_clear_error (&error);
+  g_assert_false (crfpmoc_fp_info_parse (3, NULL, 0, &info, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+}
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+
+  g_test_add_func ("/crfpmoc/fp-info/pick-version", test_pick_version);
+  g_test_add_func ("/crfpmoc/fp-info/response-size", test_response_size);
+  g_test_add_func ("/crfpmoc/fp-info/v1", test_v1);
+  g_test_add_func ("/crfpmoc/fp-info/v2", test_v2);
+  g_test_add_func ("/crfpmoc/fp-info/v3", test_v3);
+  g_test_add_func ("/crfpmoc/fp-info/v3-no-vendor-format", test_v3_no_vendor_format);
+  g_test_add_func ("/crfpmoc/fp-info/v3-header-only", test_v3_header_only);
+  g_test_add_func ("/crfpmoc/fp-info/bad-version", test_bad_version);
+
+  return g_test_run ();
+}
