new file mode 100644
index 00000000..14aa7521
--- /dev/null
+++ b/libfprint/drivers/crfpmoc/crfpmoc-fp-info.h
@@ -0,0 +1,109 @@
+/*
+ * ChromeOS Fingerprint driver for libfprint - EC_CMD_FP_INFO parsing
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/* Device independent (unit tested) parsing of EC_CMD_FP_INFO responses.
+ *
+ * Older FPMCU firmware (bloonchipper, dartmonkey, ...) answers v0/v1 with
+ * struct ec_response_fp_info (48 bytes). Newer Zephyr firmware (e.g. the
+ * USB "srebrna" FPMCU in the Lenovo Googlebook 15) only answers v3:
+ *
+ *   struct ec_response_fp_info_v3 {
+ *     struct fp_sensor_info sensor_info;       20 bytes
+ *     struct fp_template_info template_info;   16 bytes
+ *     struct fp_image_frame_params_v2 image_frame_params[];  20 bytes each
+ *   };
+ *
+ * v2 has the same header with 16-byte struct fp_image_frame_params entries.
+ * The EC always writes FP_MAX_CAPTURE_TYPES (10) entries for v2/v3 and
+ * fails with EC_RES_OVERFLOW if the host buffer is smaller.
+ * Source: chromiumos/platform/ec include/ec_commands.h and
+ * common/fpsensor/fpsensor.cc fp_command_info().
+ */
+
+#pragma once
+
+#include <glib.h>
+
+G_BEGIN_DECLS
+
+/* Generic EC command: get the supported versions of another command (v1
+ * takes a 16-bit command number). */
+#define CRFPMOC_EC_CMD_GET_CMD_VERSIONS 0x0008
+
+#define CRFPMOC_FP_MAX_CAPTURE_TYPES 10
+/* enum fp_capture_type: the format used for enrollment/matching */
+#define CRFPMOC_FP_CAPTURE_VENDOR_FORMAT 0
+
+#define CRFPMOC_FP_INFO_V1_SIZE 48
+#define CRFPMOC_FP_INFO_V2_HEADER_SIZE 36 /* fp_sensor_info + fp_template_info */
+#define CRFPMOC_FP_INFO_V2_FRAME_SIZE 16  /* struct fp_image_frame_params */
+#define CRFPMOC_FP_INFO_V3_FRAME_SIZE 20  /* struct fp_image_frame_params_v2 */
+
+struct crfpmoc_ec_params_get_cmd_versions_v1
+{
+  guint16 cmd;
+} __attribute__((packed));
+
+struct crfpmoc_ec_response_get_cmd_versions
+{
+  guint32 version_mask;
+} __attribute__((packed));
+
+/* Version independent view of an FP_INFO response */
+typedef struct
+{
+  guint32  vendor_id;
+  guint32  product_id;
+  guint32  model_id;
+  guint32  version;
+  guint16  errors;
+  guint16  num_capture_types; /* 1 for v1 */
+
+  guint32  template_size;    /* max template size in bytes */
+  guint16  template_max;     /* maximum number of fingers/templates */
+  guint16  template_valid;   /* number of valid fingers/templates */
+  guint32  template_dirty;   /* bitmap of templates with MCU side changes */
+  guint32  template_version; /* version of the template format */
+
+  /* Frame parameters of the vendor-format capture (v1: the only frame).
+   * Informational only: the driver does not capture images. */
+  gboolean has_frame;
+  guint8   capture_type;
+  guint32  frame_size;
+  guint32  pixel_format;
+  guint16  width;
+  guint16  height;
+  guint16  bpp;
+} CrfpMocFpInfo;
+
+/* Highest FP_INFO version this driver can parse in an
+ * EC_CMD_GET_CMD_VERSIONS mask (3, 2 or 1), or -1 if none. */
+int crfpmoc_fp_info_pick_version (guint32 version_mask);
+
+/* Response buffer size to request for FP_INFO @version, 0 if unsupported. */
+gsize crfpmoc_fp_info_response_size (int version);
+
+/* Parse the @len bytes received for FP_INFO @version into @info. Errors are
+ * in the G_IO_ERROR domain. */
+gboolean crfpmoc_fp_info_parse (int            version,
+                                const guint8  *buf,
+                                gsize          len,
+                                CrfpMocFpInfo *info,
+                                GError       **error);
+
+G_END_DECLS
