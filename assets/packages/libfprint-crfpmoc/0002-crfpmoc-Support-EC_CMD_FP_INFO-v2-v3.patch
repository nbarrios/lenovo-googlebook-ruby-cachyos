+/* New EC_CMD_FP_INFO transfer using the version negotiated at open, with the
+ * response buffer sized for that version (v2/v3 include all frame entries,
+ * the EC refuses smaller buffers). */
+static CrfpMocEcTransfer *
+crfpmoc_fp_info_transfer_new (FpDevice *device)
+{
+  FpiDeviceCrfpMoc *self = FPI_DEVICE_CRFPMOC (device);
+  int version = self->fp_info_version ? self->fp_info_version : 1;
+
+  return crfpmoc_ec_transfer_new_cmd (device, CRFPMOC_EC_CMD_FP_INFO, version,
+                                      NULL, 0,
+                                      crfpmoc_fp_info_response_size (version));
+}
+
+/* Parse a completed FP_INFO transfer. */
+static gboolean
+crfpmoc_fp_info_from_transfer (CrfpMocEcTransfer *transfer,
+                               CrfpMocFpInfo     *info,
+                               GError           **error)
+{
+  g_autoptr(GError) local_error = NULL;
+
+  if (!crfpmoc_fp_info_parse (transfer->version, transfer->indata,
+                              MAX (transfer->inlen, 0), info, &local_error))
+    {
+      g_set_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                   "%s", local_error->message);
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
 /* Parse the device info response, vendor, version, etc. Get the state
  * of the loaded templates and how many can be loaded as well as the
  * size of templates. All templates have the same size on a given device.
  */
 static gboolean
-crfpmoc_parse_fp_info (struct crfpmoc_ec_response_fp_info *r,
-                       guint16                            *max_templates,
-                       guint16                            *template_size,
-                       GError                            **error)
+crfpmoc_parse_fp_info (const CrfpMocFpInfo *r,
+                       guint16             *max_templates,
+                       guint16             *template_size,
+                       GError             **error)
 {
   gchar vendor[5];
   const gchar *model = NULL;
@@ -771,7 +806,11 @@ crfpmoc_parse_fp_info (struct crfpmoc_ec_response_fp_info *r,
     }
   fp_dbg ("Fingerprint sensor: vendor %s product %x model %x (%s) version %x",
           vendor, r->product_id, r->model_id, model ? model : "", r->version);
-  fp_dbg ("Image: size %dx%d %d bpp", r->width, r->height, r->bpp);
+  if (r->has_frame)
+    fp_dbg ("Image: size %dx%d %d bpp, frame %u bytes, capture type %u of %u",
+            r->width, r->height, r->bpp, r->frame_size, r->capture_type,
+            r->num_capture_types);
+  fp_dbg ("Sensor errors: 0x%04x", r->errors);
   fp_dbg ("Templates: version %d size %d count %d/%d dirty bitmap %x",
           r->template_version, r->template_size, r->template_valid,
           r->template_max, r->template_dirty);
@@ -959,6 +998,69 @@ crfpmoc_open_proto_info_cb (CrfpMocEcTransfer *transfer, GAsyncResult *res, gpoi
   fpi_ssm_next_state (ssm);
 }
 
+static void
+crfpmoc_open_fp_info_versions_cb (CrfpMocEcTransfer *transfer, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr(GError) error = NULL;
+  FpiSsm *ssm = user_data;
+  FpDevice *device = fpi_ssm_get_device (ssm);
+  FpiDeviceCrfpMoc *self = FPI_DEVICE_CRFPMOC (device);
+  struct crfpmoc_ec_response_get_cmd_versions *r = transfer->indata;
+  gsize size;
+  int version;
+
+  if (!crfpmoc_ec_transfer_submit_finish (res, &error))
+    {
+      if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        {
+          fpi_ssm_mark_failed (ssm, g_steal_pointer (&error));
+          return;
+        }
+
+      /* Every cros_ec firmware implements GET_CMD_VERSIONS v1, but do not
+       * fail hard: fall back to the historical FP_INFO v1. */
+      fp_warn ("Could not query FP_INFO versions (%s), assuming v1", error->message);
+      self->fp_info_version = 1;
+      fpi_ssm_next_state (ssm);
+      return;
+    }
+
+  if (transfer->inlen < (int) sizeof (*r))
+    {
+      fp_warn ("Short GET_CMD_VERSIONS response, assuming FP_INFO v1");
+      self->fp_info_version = 1;
+      fpi_ssm_next_state (ssm);
+      return;
+    }
+
+  version = crfpmoc_fp_info_pick_version (GUINT32_FROM_LE (r->version_mask));
+  fp_dbg ("FP_INFO version mask 0x%x, using v%d",
+          GUINT32_FROM_LE (r->version_mask), version);
+
+  if (version < 0)
+    {
+      fpi_ssm_mark_failed (ssm,
+                           fpi_device_error_new_msg (FP_DEVICE_ERROR_NOT_SUPPORTED,
+                                                     "FPMCU supports no known FP_INFO version (mask 0x%x)",
+                                                     GUINT32_FROM_LE (r->version_mask)));
+      return;
+    }
+
+  size = crfpmoc_fp_info_response_size (version);
+  if (size > self->max_insize)
+    {
+      fpi_ssm_mark_failed (ssm,
+                           fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                     "FP_INFO v%d response (%" G_GSIZE_FORMAT
+                                                     " bytes) exceeds max response payload %u",
+                                                     version, size, self->max_insize));
+      return;
+    }
+
+  self->fp_info_version = version;
+  fpi_ssm_next_state (ssm);
+}
+
