diff --git a/libfprint/drivers/crfpmoc/crfpmoc-fp-info.c b/libfprint/drivers/crfpmoc/crfpmoc-fp-info.c
new file mode 100644
index 00000000..a44b5e20
--- /dev/null
+++ b/libfprint/drivers/crfpmoc/crfpmoc-fp-info.c
@@ -0,0 +1,205 @@
+/*
+ * ChromeOS Fingerprint driver for libfprint - EC_CMD_FP_INFO parsing
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <string.h>
+#include <gio/gio.h>
+
+#include "crfpmoc-fp-info.h"
+
+/* The EC protocol is little endian; read fields explicitly instead of
+ * casting the buffer, so short or unaligned responses are safe. */
+static guint16
+rd16 (const guint8 *p)
+{
+  return (guint16) (p[0] | (p[1] << 8));
+}
+
+static guint32
+rd32 (const guint8 *p)
+{
+  return (guint32) p[0] | ((guint32) p[1] << 8) |
+         ((guint32) p[2] << 16) | ((guint32) p[3] << 24);
+}
+
+int
+crfpmoc_fp_info_pick_version (guint32 version_mask)
+{
+  for (int v = 3; v >= 1; v--)
+    if (version_mask & (1u << v))
+      return v;
+  return -1;
+}
+
+static gsize
+frame_entry_size (int version)
+{
+  return version == 3 ? CRFPMOC_FP_INFO_V3_FRAME_SIZE : CRFPMOC_FP_INFO_V2_FRAME_SIZE;
+}
+
+gsize
+crfpmoc_fp_info_response_size (int version)
+{
+  switch (version)
+    {
+    case 1:
+      return CRFPMOC_FP_INFO_V1_SIZE;
+
+    case 2:
+    case 3:
+      return CRFPMOC_FP_INFO_V2_HEADER_SIZE +
+             CRFPMOC_FP_MAX_CAPTURE_TYPES * frame_entry_size (version);
+
+    default:
+      return 0;
+    }
+}
+
+static void
+parse_v1 (const guint8 *b, CrfpMocFpInfo *info)
+{
+  /* struct ec_response_fp_info */
+  info->vendor_id = rd32 (b + 0);
+  info->product_id = rd32 (b + 4);
+  info->model_id = rd32 (b + 8);
+  info->version = rd32 (b + 12);
+  info->frame_size = rd32 (b + 16);
+  info->pixel_format = rd32 (b + 20);
+  info->width = rd16 (b + 24);
+  info->height = rd16 (b + 26);
+  info->bpp = rd16 (b + 28);
+  info->errors = rd16 (b + 30);
+  info->template_size = rd32 (b + 32);
+  info->template_max = rd16 (b + 36);
+  info->template_valid = rd16 (b + 38);
+  info->template_dirty = rd32 (b + 40);
+  info->template_version = rd32 (b + 44);
+  info->num_capture_types = 1;
+  info->has_frame = TRUE;
+  info->capture_type = CRFPMOC_FP_CAPTURE_VENDOR_FORMAT;
+}
+
+static void
+parse_v2_v3 (int version, const guint8 *b, gsize len, CrfpMocFpInfo *info)
+{
+  const gsize entry = frame_entry_size (version);
+  gsize available;
+  guint n;
+
+  /* struct fp_sensor_info */
+  info->vendor_id = rd32 (b + 0);
+  info->product_id = rd32 (b + 4);
+  info->model_id = rd32 (b + 8);
+  info->version = rd32 (b + 12);
+  info->num_capture_types = rd16 (b + 16);
+  info->errors = rd16 (b + 18);
+  /* struct fp_template_info */
+  info->template_size = rd32 (b + 20);
+  info->template_max = rd16 (b + 24);
+  info->template_valid = rd16 (b + 26);
+  info->template_dirty = rd32 (b + 28);
+  info->template_version = rd32 (b + 32);
+
+  /* Frame parameters: never trust num_capture_types beyond what was
+   * actually received or the protocol maximum. Prefer the vendor-format
+   * entry, else take the first one. */
+  available = (len - CRFPMOC_FP_INFO_V2_HEADER_SIZE) / entry;
+  n = MIN (MIN ((gsize) info->num_capture_types, available),
+           (gsize) CRFPMOC_FP_MAX_CAPTURE_TYPES);
+
+  for (guint i = 0; i < n; i++)
+    {
+      const guint8 *f = b + CRFPMOC_FP_INFO_V2_HEADER_SIZE + i * entry;
+      guint8 type;
+
+      if (version == 3)
+        type = f[18]; /* after frame_size, image_data_offset_bytes, pixel_format, w, h, bpp */
+      else
+        type = f[14]; /* after frame_size, pixel_format, w, h, bpp */
+
+      if (info->has_frame && type != CRFPMOC_FP_CAPTURE_VENDOR_FORMAT)
+        continue;
+
+      info->has_frame = TRUE;
+      info->capture_type = type;
+      info->frame_size = rd32 (f);
+      if (version == 3)
+        {
+          info->pixel_format = rd32 (f + 8);
+          info->width = rd16 (f + 12);
+          info->height = rd16 (f + 14);
+          info->bpp = rd16 (f + 16);
+        }
+      else
+        {
+          info->pixel_format = rd32 (f + 4);
+          info->width = rd16 (f + 8);
+          info->height = rd16 (f + 10);
+          info->bpp = rd16 (f + 12);
+        }
+
+      if (type == CRFPMOC_FP_CAPTURE_VENDOR_FORMAT)
+        break;
+    }
+}
+
+gboolean
+crfpmoc_fp_info_parse (int            version,
+                       const guint8  *buf,
+                       gsize          len,
+                       CrfpMocFpInfo *info,
+                       GError       **error)
+{
+  gsize need;
+
+  g_return_val_if_fail (info != NULL, FALSE);
+
+  memset (info, 0, sizeof (*info));
+
+  switch (version)
+    {
+    case 1:
+      need = CRFPMOC_FP_INFO_V1_SIZE;
+      break;
+
+    case 2:
+    case 3:
+      need = CRFPMOC_FP_INFO_V2_HEADER_SIZE;
+      break;
+
+    default:
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+                   "Unsupported FP_INFO version %d", version);
+      return FALSE;
+    }
+
+  if (buf == NULL || len < need)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                   "FP_INFO v%d response too short (%" G_GSIZE_FORMAT
+                   " bytes, need %" G_GSIZE_FORMAT ")",
+                   version, buf ? len : 0, need);
+      return FALSE;
+    }
+
+  if (version == 1)
+    parse_v1 (buf, info);
+  else
+    parse_v2_v3 (version, buf, len, info);
+
+  return TRUE;
+}
