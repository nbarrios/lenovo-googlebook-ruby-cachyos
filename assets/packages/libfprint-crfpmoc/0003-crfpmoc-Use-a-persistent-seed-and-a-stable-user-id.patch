diff --git a/libfprint/drivers/crfpmoc/crfpmoc-seed.c b/libfprint/drivers/crfpmoc/crfpmoc-seed.c
new file mode 100644
index 00000000..073bae71
--- /dev/null
+++ b/libfprint/drivers/crfpmoc/crfpmoc-seed.c
@@ -0,0 +1,265 @@
+/*
+ * ChromeOS Fingerprint driver for libfprint - persistent FP_SEED
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/random.h>
+#include <sys/stat.h>
+#include <gio/gio.h>
+
+#include "crfpmoc-seed.h"
+
+#define USERID_LABEL "crfpmoc-userid-v1"
+
+static gboolean
+set_errno_error (GError **error, int errsv, const char *what, const char *path)
+{
+  g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errsv),
+               "%s %s: %s", what, path, g_strerror (errsv));
+  return FALSE;
+}
+
+/* Open (creating if needed) the seed directory and check it cannot be
+ * modified by anyone but @owner. */
+static int
+open_seed_dir (const char *dir, uid_t owner, GError **error)
+{
+  struct stat st;
+  int dfd;
+
+  if (mkdir (dir, 0700) < 0 && errno != EEXIST)
+    {
+      set_errno_error (error, errno, "Cannot create", dir);
+      return -1;
+    }
+
+  dfd = open (dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  if (dfd < 0)
+    {
+      set_errno_error (error, errno, "Cannot open", dir);
+      return -1;
+    }
+
+  if (fstat (dfd, &st) < 0)
+    {
+      set_errno_error (error, errno, "Cannot stat", dir);
+      close (dfd);
+      return -1;
+    }
+
+  if (st.st_uid != owner || (st.st_mode & (S_IWGRP | S_IWOTH)))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                   "Refusing seed directory %s: owner %u mode %04o "
+                   "(must be owned by uid %u and not group/world writable)",
+                   dir, (unsigned) st.st_uid, (unsigned) (st.st_mode & 07777),
+                   (unsigned) owner);
+      close (dfd);
+      return -1;
+    }
+
+  return dfd;
+}
+
+static gboolean
+fill_random (guint8 *buf, gsize len, GError **error)
+{
+  gsize done = 0;
+
+  while (done < len)
+    {
+      ssize_t r = getrandom (buf + done, len - done, 0);
+
+      if (r < 0)
+        {
+          if (errno == EINTR)
+            continue;
+          return set_errno_error (error, errno, "getrandom failed for", "seed");
+        }
+      done += r;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+write_all (int fd, const guint8 *buf, gsize len)
+{
+  while (len > 0)
+    {
+      ssize_t r = write (fd, buf, len);
+
+      if (r < 0)
+        {
+          if (errno == EINTR)
+            continue;
+          return FALSE;
+        }
+      buf += r;
+      len -= r;
+    }
+  return TRUE;
+}
+
+/* Create @base in @dfd atomically with fresh random content. Losing a race
+ * against another creator is fine: the caller then reads the winner's file. */
+static gboolean
+create_seed_file (int dfd, const char *path, const char *base, GError **error)
+{
+  g_autofree char *tmp = g_strdup_printf (".%s.tmp.%d", base, (int) getpid ());
+  guint8 seed[CRFPMOC_SEED_BYTES];
+  gboolean ok = FALSE;
+  int fd;
+
+  unlinkat (dfd, tmp, 0);
+  fd = openat (dfd, tmp, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+  if (fd < 0)
+    return set_errno_error (error, errno, "Cannot create temporary seed file for", path);
+
+  if (!fill_random (seed, sizeof (seed), error))
+    goto out;
+
+  if (fchmod (fd, 0600) < 0 || !write_all (fd, seed, sizeof (seed)) || fsync (fd) < 0)
+    {
+      set_errno_error (error, errno, "Cannot write", path);
+      goto out;
+    }
+
+  /* link() never replaces an existing file */
+  if (linkat (dfd, tmp, dfd, base, 0) < 0 && errno != EEXIST)
+    {
+      set_errno_error (error, errno, "Cannot create", path);
+      goto out;
+    }
+
+  fsync (dfd);
+  g_message ("crfpmoc: created new fingerprint seed %s", path);
+  ok = TRUE;
+
+out:
+  explicit_bzero (seed, sizeof (seed));
+  close (fd);
+  unlinkat (dfd, tmp, 0);
+  return ok;
+}
+
+gboolean
+crfpmoc_seed_load_or_create (const char *path,
+                             uid_t       owner,
+                             guint8      seed[CRFPMOC_SEED_BYTES],
+                             GError    **error)
+{
+  g_autofree char *dir = NULL;
+  g_autofree char *base = NULL;
+  struct stat st;
+  gsize done = 0;
+  gboolean ok = FALSE;
+  int dfd;
+  int fd;
+
+  g_return_val_if_fail (path != NULL && g_path_is_absolute (path), FALSE);
+
+  dir = g_path_get_dirname (path);
+  base = g_path_get_basename (path);
+
+  dfd = open_seed_dir (dir, owner, error);
+  if (dfd < 0)
+    return FALSE;
+
+  fd = openat (dfd, base, O_RDONLY | O_NOFOLLOW | O_NOCTTY | O_CLOEXEC);
+  if (fd < 0 && errno == ENOENT)
+    {
+      if (!create_seed_file (dfd, path, base, error))
+        goto out_dir;
+      fd = openat (dfd, base, O_RDONLY | O_NOFOLLOW | O_NOCTTY | O_CLOEXEC);
+    }
+  if (fd < 0)
+    {
+      set_errno_error (error, errno, "Cannot open", path);
+      goto out_dir;
+    }
+
+  if (fstat (fd, &st) < 0)
+    {
+      set_errno_error (error, errno, "Cannot stat", path);
+      goto out;
+    }
+
+  if (!S_ISREG (st.st_mode) || st.st_uid != owner ||
+      (st.st_mode & 07777 & ~(mode_t) 0600))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                   "Refusing seed file %s: owner %u mode %04o "
+                   "(must be a regular file owned by uid %u, mode 0600 or stricter)",
+                   path, (unsigned) st.st_uid, (unsigned) (st.st_mode & 07777),
+                   (unsigned) owner);
+      goto out;
+    }
+
+  if (st.st_size != CRFPMOC_SEED_BYTES)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                   "Seed file %s has %" G_GINT64_FORMAT " bytes, expected %d",
+                   path, (gint64) st.st_size, CRFPMOC_SEED_BYTES);
+      goto out;
+    }
+
+  while (done < CRFPMOC_SEED_BYTES)
+    {
+      ssize_t r = read (fd, seed + done, CRFPMOC_SEED_BYTES - done);
+
+      if (r < 0 && errno == EINTR)
+        continue;
+      if (r <= 0)
+        {
+          if (r == 0)
+            g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                         "Short read from %s", path);
+          else
+            set_errno_error (error, errno, "Cannot read", path);
+          explicit_bzero (seed, CRFPMOC_SEED_BYTES);
+          goto out;
+        }
+      done += r;
+    }
+
+  ok = TRUE;
+
+out:
+  close (fd);
+out_dir:
+  close (dfd);
+  return ok;
+}
+
+void
+crfpmoc_derive_user_id (const guint8 seed[CRFPMOC_SEED_BYTES],
+                        guint8       user_id[CRFPMOC_USERID_BYTES])
+{
+  g_autoptr(GChecksum) sum = g_checksum_new (G_CHECKSUM_SHA256);
+  gsize len = CRFPMOC_USERID_BYTES;
+
+  G_STATIC_ASSERT (CRFPMOC_USERID_BYTES == 32); /* SHA-256 digest size */
+
+  g_checksum_update (sum, (const guchar *) USERID_LABEL, strlen (USERID_LABEL));
+  g_checksum_update (sum, seed, CRFPMOC_SEED_BYTES);
+  g_checksum_get_digest (sum, user_id, &len);
+  g_assert (len == CRFPMOC_USERID_BYTES);
+}
diff --git a/libfprint/drivers/crfpmoc/crfpmoc-seed.h b/libfprint/drivers/crfpmoc/crfpmoc-seed.h
new file mode 100644
index 00000000..4faa563f
--- /dev/null
+++ b/libfprint/drivers/crfpmoc/crfpmoc-seed.h
@@ -0,0 +1,66 @@
+/*
+ * ChromeOS Fingerprint driver for libfprint - persistent FP_SEED
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/* The FPMCU encrypts every template it hands to the host with a key derived
+ * from an MCU-internal secret, the FP_SEED (32 bytes, write-once per FPMCU
+ * boot) and the FP_CONTEXT user id. ChromeOS derives the seed from the TPM.
+ * Upstream crfpmoc picks a random seed and user id on every open, so stored
+ * prints stop matching after fprintd restarts or the machine reboots.
+ *
+ * Here the seed lives in a root-only file created once with getrandom(2),
+ * and the user id is derived from it, so prints survive reboots.
+ *
+ * Security trade-off: the seed is stored in plaintext (0600 root) instead of
+ * being sealed to the TPM. Templates stay useless without this particular
+ * FPMCU (its internal key never leaves the chip), but anyone who can read
+ * the seed and the stored prints (root, or offline access to an unencrypted
+ * disk) can load them back into this FPMCU. Root can already fake matches on
+ * a match-on-chip reader without authenticated sessions, so this matches the
+ * existing trust model; TPM sealing would only add protection against
+ * offline disk access.
+ */
+
+#pragma once
+
+#include <glib.h>
+#include <sys/types.h>
+
+G_BEGIN_DECLS
+
+#define CRFPMOC_SEED_FILE "/var/lib/fprint/crfpmoc-seed"
+#define CRFPMOC_SEED_BYTES 32   /* FP_CONTEXT_TPM_BYTES */
+#define CRFPMOC_USERID_BYTES 32 /* FP_CONTEXT_USERID_BYTES */
+
+/* Read the seed from @path, creating it (and a missing parent directory,
+ * mode 0700) with getrandom(2) if it does not exist. Refuses a file that is
+ * not a regular file of exactly CRFPMOC_SEED_BYTES bytes owned by @owner
+ * with no permission bits outside 0600, or whose directory is not owned by
+ * @owner or is group/world writable. The driver passes owner 0 (root);
+ * tests pass their own uid. Errors are in the G_IO_ERROR domain. */
+gboolean crfpmoc_seed_load_or_create (const char *path,
+                                      uid_t       owner,
+                                      guint8      seed[CRFPMOC_SEED_BYTES],
+                                      GError    **error);
+
+/* Stable FP_CONTEXT user id: SHA-256 ("crfpmoc-userid-v1" || seed). One user
+ * id per machine: the FPMCU holds a single context, and identify galleries
+ * may mix users. */
+void crfpmoc_derive_user_id (const guint8 seed[CRFPMOC_SEED_BYTES],
+                             guint8       user_id[CRFPMOC_USERID_BYTES]);
+
+G_END_DECLS
diff --git a/libfprint/drivers/crfpmoc/crfpmoc.c b/libfprint/drivers/crfpmoc/crfpmoc.c
index b4475868..6c637085 100644
--- a/libfprint/drivers/crfpmoc/crfpmoc.c
+++ b/libfprint/drivers/crfpmoc/crfpmoc.c
@@ -29,6 +29,7 @@
 #include "crfpmoc.h"
 #include "crfpmoc-ec-transfer.h"
 #include "crfpmoc-fp-info.h"
+#include "crfpmoc-seed.h"
 
 struct _FpiDeviceCrfpMoc
 {
@@ -1138,12 +1139,18 @@ crfpmoc_open_ssm_done (FpiSsm *ssm, FpDevice *device, GError *error)
   fpi_device_open_complete (device, error);
 }
 
-/* Initialise the per-session encryption seed and user context. In emulation
- * mode fixed test values are used so the recorded ioctl replay stays
- * deterministic; on real hardware random values are generated.
+/* Initialise the encryption seed and user context. In emulation mode fixed
+ * test values are used so the recorded ioctl replay stays deterministic.
+ *
+ * On real hardware the seed comes from a root-only file that is created once
+ * with getrandom(2), and the FP_CONTEXT user id is derived from it, so the
+ * FPMCU derives the same template key after fprintd restarts, FPMCU reboots
+ * and host reboots. (Upstream generated both randomly on every open, which
+ * made stored prints unusable after a reboot.) See crfpmoc-seed.h for the
+ * security trade-off of a plaintext seed file versus TPM sealing.
  */
-static void
-crfpmoc_init_keys (FpiDeviceCrfpMoc *self)
+static gboolean
+crfpmoc_init_keys (FpiDeviceCrfpMoc *self, GError **error)
 {
   G_STATIC_ASSERT (sizeof (self->seed) == CRFPMOC_FP_CONTEXT_TPM_BYTES);
   G_STATIC_ASSERT (sizeof (self->context) == CRFPMOC_FP_CONTEXT_USERID_BYTES);
@@ -1157,12 +1164,30 @@ crfpmoc_init_keys (FpiDeviceCrfpMoc *self)
     }
   else
     {
-      for (size_t i = 0; i < sizeof (self->seed); i++)
-        self->seed[i] = (guint8) g_random_int_range (0, 256);
+      g_autoptr(GError) local_error = NULL;
+
+      G_STATIC_ASSERT (sizeof (self->seed) == CRFPMOC_SEED_BYTES);
+      G_STATIC_ASSERT (sizeof (self->context) == CRFPMOC_USERID_BYTES);
+
+      if (!crfpmoc_seed_load_or_create (CRFPMOC_SEED_FILE, 0, self->seed, &local_error))
+        {
+          g_set_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL,
+                       "Cannot load the fingerprint seed: %s", local_error->message);
+          return FALSE;
+        }
 
-      for (size_t i = 0; i < sizeof (self->context); i++)
-        self->context[i] = (guint8) g_random_int_range (0, 256);
+      crfpmoc_derive_user_id (self->seed, self->context);
+      fp_dbg ("Loaded persistent seed from %s", CRFPMOC_SEED_FILE);
     }
+
+  return TRUE;
+}
+
+static void
+crfpmoc_clear_keys (FpiDeviceCrfpMoc *self)
+{
+  explicit_bzero (self->seed, sizeof (self->seed));
+  explicit_bzero (self->context, sizeof (self->context));
 }
 
 static void
@@ -1193,7 +1218,12 @@ crfpmoc_open (FpDevice *device)
       fp_dbg ("Created temporary ioctl file for recording: %s", ioctl_file);
     }
 
-  crfpmoc_init_keys (self);
+  if (!crfpmoc_init_keys (self, &error))
+    {
+      g_clear_fd (&self->emul_fd, NULL);
+      fpi_device_open_complete (device, g_steal_pointer (&error));
+      return;
+    }
 
   g_assert (self->task_ssm == NULL);
   self->task_ssm = fpi_ssm_new (device, crfpmoc_open_run_state, OPEN_STATES);
@@ -1250,6 +1280,7 @@ crfpmoc_close (FpDevice *device)
   fp_dbg ("Closing device");
 
   crfpmoc_reset_sync (device);
+  crfpmoc_clear_keys (self);
   g_clear_fd (&self->emul_fd, &error);
 
   fpi_device_close_complete (device, g_steal_pointer (&error));
@@ -1987,9 +2018,12 @@ crfpmoc_keys_enc_status_cb (CrfpMocEcTransfer *transfer, GAsyncResult *res, gpoi
     }
 
   resp = (struct crfpmoc_ec_response_fp_encryption_status *) transfer->indata;
-  fp_dbg ("crfpmoc_keys_enc_status_cb: FPMCU encryption status: %d", resp->status);
+  fp_dbg ("crfpmoc_keys_enc_status_cb: FPMCU encryption status: 0x%x (valid 0x%x)",
+          resp->status, resp->valid_flags);
 
-  if (resp->status == 0)
+  /* FP_SEED is accepted once per FPMCU boot. If it is already set we assume
+   * it is our persistent seed, set by an earlier open in this FPMCU boot. */
+  if (!(resp->status & CRFPMOC_FP_ENC_STATUS_SEED_SET))
     fpi_ssm_next_state (ssm); /* KEYS_SET_SEED */
   else
     fpi_ssm_jump_to_state (ssm, KEYS_CTX_ASYNC);
@@ -2003,6 +2037,21 @@ crfpmoc_keys_seed_cb (CrfpMocEcTransfer *transfer, GAsyncResult *res, gpointer u
 
   if (!crfpmoc_ec_transfer_submit_finish (res, &error))
     {
+      /* Seed got set between the status query and now (or the status bit
+       * is not reported). Carry on: if it was set by us, all is well; if
+       * another OS set a different seed before a warm reboot, prints will
+       * not match until the FPMCU is rebooted. */
+      if (transfer->ec_result == EC_RES_ACCESS_DENIED)
+        {
+          /* Not fp_warn: expected after a warm reboot, and tests run with
+           * fatal warnings. g_message is shown in the journal by default. */
+          g_message ("crfpmoc: FP_SEED already set in this FPMCU boot; continuing. If "
+                   "prints do not match, reboot the FPMCU (ectool --name=cros_fp "
+                   "reboot_ec) so the persistent seed can be set.");
+          fpi_ssm_next_state (ssm); /* KEYS_CTX_ASYNC */
+          return;
+        }
+
       fpi_ssm_mark_failed (ssm, g_steal_pointer (&error));
       return;
     }
