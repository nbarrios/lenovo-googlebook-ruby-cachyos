         test_exe = executable('test-' + test_name,
diff --git a/tests/test-crfpmoc-seed.c b/tests/test-crfpmoc-seed.c
new file mode 100644
index 00000000..8f2bd336
--- /dev/null
+++ b/tests/test-crfpmoc-seed.c
@@ -0,0 +1,205 @@
+/*
+ * Unit tests for the crfpmoc persistent seed file
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <string.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <glib/gstdio.h>
+#include <gio/gio.h>
+
+#include "crfpmoc-seed.h"
+
+typedef struct
+{
+  char *tmpdir;
+  char *dir;
+  char *path;
+} Fixture;
+
+static void
+fixture_setup (Fixture *f, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+
+  f->tmpdir = g_dir_make_tmp ("crfpmoc-seed-XXXXXX", &error);
+  g_assert_no_error (error);
+  /* Not created yet: the loader must create it 0700 */
+  f->dir = g_build_filename (f->tmpdir, "fprint", NULL);
+  f->path = g_build_filename (f->dir, "crfpmoc-seed", NULL);
+}
+
+static void
+fixture_teardown (Fixture *f, gconstpointer data)
+{
+  g_autofree char *link = g_build_filename (f->dir, "link", NULL);
+
+  g_chmod (f->dir, 0700);
+  g_unlink (link);
+  g_unlink (f->path);
+  g_rmdir (f->dir);
+  g_rmdir (f->tmpdir);
+  g_free (f->path);
+  g_free (f->dir);
+  g_free (f->tmpdir);
+}
+
+static void
+test_create_and_reload (Fixture *f, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  guint8 seed1[CRFPMOC_SEED_BYTES], seed2[CRFPMOC_SEED_BYTES];
+  guint8 zero[CRFPMOC_SEED_BYTES] = { 0 };
+  g_autofree char *contents = NULL;
+  gsize len;
+  GStatBuf st;
+
+  g_assert_true (crfpmoc_seed_load_or_create (f->path, getuid (), seed1, &error));
+  g_assert_no_error (error);
+  g_assert_true (memcmp (seed1, zero, sizeof (zero)) != 0);
+
+  g_assert_cmpint (g_stat (f->dir, &st), ==, 0);
+  g_assert_cmphex (st.st_mode & 07777, ==, 0700);
+  g_assert_cmpint (g_stat (f->path, &st), ==, 0);
+  g_assert_cmphex (st.st_mode & 07777, ==, 0600);
+  g_assert_cmpint (st.st_size, ==, CRFPMOC_SEED_BYTES);
+
+  g_assert_true (g_file_get_contents (f->path, &contents, &len, NULL));
+  g_assert_cmpmem (contents, len, seed1, sizeof (seed1));
+
+  /* Stable across loads */
+  g_assert_true (crfpmoc_seed_load_or_create (f->path, getuid (), seed2, &error));
+  g_assert_no_error (error);
+  g_assert_cmpmem (seed1, sizeof (seed1), seed2, sizeof (seed2));
+
+  /* Stricter permissions are fine */
+  g_assert_cmpint (g_chmod (f->path, 0400), ==, 0);
+  g_assert_true (crfpmoc_seed_load_or_create (f->path, getuid (), seed2, &error));
+  g_assert_no_error (error);
+}
+
+static void
+test_wide_permissions (Fixture *f, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  guint8 seed[CRFPMOC_SEED_BYTES];
+  const int bad_modes[] = { 0640, 0604, 0644, 0700, 0610, 04600 };
+
+  g_assert_true (crfpmoc_seed_load_or_create (f->path, getuid (), seed, &error));
+
+  for (guint i = 0; i < G_N_ELEMENTS (bad_modes); i++)
+    {
+      g_assert_cmpint (g_chmod (f->path, bad_modes[i]), ==, 0);
+      g_assert_false (crfpmoc_seed_load_or_create (f->path, getuid (), seed, &error));
+      g_assert_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED);
+      g_clear_error (&error);
+    }
+}
+
+static void
+test_wrong_owner (Fixture *f, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  guint8 seed[CRFPMOC_SEED_BYTES];
+
+  g_assert_true (crfpmoc_seed_load_or_create (f->path, getuid (), seed, &error));
+  /* Directory and file belong to us, not to the expected owner */
+  g_assert_false (crfpmoc_seed_load_or_create (f->path, getuid () + 1, seed, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED);
+}
+
+static void
+test_writable_dir (Fixture *f, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  guint8 seed[CRFPMOC_SEED_BYTES];
+
+  g_assert_true (crfpmoc_seed_load_or_create (f->path, getuid (), seed, &error));
+  g_assert_cmpint (g_chmod (f->dir, 0770), ==, 0);
+  g_assert_false (crfpmoc_seed_load_or_create (f->path, getuid (), seed, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED);
+}
+
+static void
+test_wrong_size (Fixture *f, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  guint8 seed[CRFPMOC_SEED_BYTES];
+
+  g_assert_cmpint (g_mkdir (f->dir, 0700), ==, 0);
+  g_assert_true (g_file_set_contents_full (f->path, "short", 5,
+                                           G_FILE_SET_CONTENTS_NONE, 0600, NULL));
+  g_assert_false (crfpmoc_seed_load_or_create (f->path, getuid (), seed, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+}
+
+static void
+test_symlink (Fixture *f, gconstpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  g_autofree char *link = g_build_filename (f->dir, "link", NULL);
+  guint8 seed[CRFPMOC_SEED_BYTES];
+
+  g_assert_true (crfpmoc_seed_load_or_create (f->path, getuid (), seed, &error));
+  g_assert_cmpint (symlink (f->path, link), ==, 0);
+  g_assert_false (crfpmoc_seed_load_or_create (link, getuid (), seed, &error));
+  g_assert_nonnull (error);
+}
+
+static void
+test_user_id (void)
+{
+  guint8 seed[CRFPMOC_SEED_BYTES];
+  guint8 id1[CRFPMOC_USERID_BYTES], id2[CRFPMOC_USERID_BYTES];
+  /* sha256 ("crfpmoc-userid-v1" || 00 01 .. 1f) */
+  static const guint8 expected[CRFPMOC_USERID_BYTES] = {
+    0x86, 0xd3, 0xda, 0xaa, 0x41, 0x8d, 0x43, 0x3e, 0x96, 0xda, 0x6b, 0x96,
+    0xbb, 0x8f, 0xe7, 0xde, 0x79, 0x51, 0x73, 0x00, 0xdc, 0xab, 0xdc, 0x6e,
+    0xa3, 0x0c, 0x88, 0xf9, 0x0b, 0xdc, 0x1d, 0x9f,
+  };
+
+  for (guint i = 0; i < sizeof (seed); i++)
+    seed[i] = i;
+
+  crfpmoc_derive_user_id (seed, id1);
+  g_assert_cmpmem (id1, sizeof (id1), expected, sizeof (expected));
+  crfpmoc_derive_user_id (seed, id2);
+  g_assert_cmpmem (id1, sizeof (id1), id2, sizeof (id2));
+
+  seed[0] ^= 1;
+  crfpmoc_derive_user_id (seed, id2);
+  g_assert_true (memcmp (id1, id2, sizeof (id1)) != 0);
+}
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+
+#define ADD(name, func) \
+  g_test_add ("/crfpmoc/seed/" name, Fixture, NULL, fixture_setup, func, fixture_teardown)
+  ADD ("create-and-reload", test_create_and_reload);
+  ADD ("wide-permissions", test_wide_permissions);
+  ADD ("wrong-owner", test_wrong_owner);
+  ADD ("writable-dir", test_writable_dir);
+  ADD ("wrong-size", test_wrong_size);
+  ADD ("symlink", test_symlink);
+#undef ADD
+  g_test_add_func ("/crfpmoc/seed/user-id", test_user_id);
+
+  return g_test_run ();
+}
